# Supply-chain defense: refuse to install any npm package version (including
# transitive deps) published less than this many DAYS ago. Most malicious
# package versions are caught and yanked within hours, so a short cooloff dodges
# the window without holding back legitimate updates for long.
#
# Unit is DAYS (npm >= 11.10.0). Requires npm 11.10.0+; older npm ignores it.
# This file is project-scoped — no global config needed. npm also reads it for
# the mock-idp/ and angular-demo/ subprojects (it walks up the directory tree).
min-release-age=2

# Packages exempt from the cooloff (name or minimatch glob). Empty by default.
# Add entries here if a legitimate just-published version is ever blocked.
# min-release-age-exclude[]=some-package
